# Keep the build context small and, more importantly, keep local state out of
# the image: a stray .env here would bake a developer's JWT secret into a layer.
.venv/
venv/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/

.env
.env.*
!.env.example

data/
tests/
Dockerfile
.dockerignore
