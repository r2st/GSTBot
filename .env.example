# Copy to .env and fill in. Never commit the filled-in file.

# ---- App ----
ENVIRONMENT=development
DEBUG=true
BACKEND_CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ---- Security ----
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET=change-me-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ---- Database ----
DATABASE_URL=postgresql+psycopg://gstbot:gstbot@localhost:5432/gstbot

# ---- Redis / Celery ----
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2
# false runs invoice parsing inline in the request instead of on a worker.
CELERY_ENABLED=true

# ---- AI (OpenRouter, free models only) ----
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=openai/gpt-oss-20b:free
OPENROUTER_VISION_MODEL=qwen/qwen2.5-vl-72b-instruct:free
OPENROUTER_APP_URL=https://gstbot.aiknol.com
OPENROUTER_APP_TITLE=GSTBot

# ---- Uploads ----
UPLOAD_DIR=./data/invoices
MAX_UPLOAD_MB=15
