[Unit]
# One handle for the whole stack:
#
#   systemctl restart gstbot.target    # migrate, then the four services
#   systemctl stop gstbot.target       # all of them, together
#   systemctl status gstbot.target
#
# Every unit here declares PartOf=gstbot.target, which is what makes stopping
# and restarting the target reach them. Wants= rather than Requires= so a
# worker that will not start does not also take the API down — a stack that
# serves reads while extraction is broken is much better than one that does
# not serve at all. The same reasoning covers gstbot-beat: a scheduler that
# will not start costs tomorrow's deadline alerts, which is not a reason to
# stop serving today.
Description=GSTBot (API, web, worker, scheduler and migrations)
Documentation=https://gstbot.aiknol.com
Wants=gstbot-migrate.service gstbot-api.service gstbot-web.service gstbot-worker.service gstbot-beat.service
After=gstbot-migrate.service

[Install]
WantedBy=multi-user.target
