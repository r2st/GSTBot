# GSTBot edge configuration — /etc/caddy/Caddyfile on the Hetzner box.
#
#   caddy validate --config /etc/caddy/Caddyfile
#   systemctl reload caddy
#
# Caddy terminates TLS (it obtains and renews the certificate for
# gstbot.aiknol.com itself) and serves two things from one origin: the built
# SPA out of /srv/gstbot/web, and the API over the loopback. One origin is the
# point — the browser never makes a cross-origin request, so CORS is not in
# the path of anything a user does and a stolen token cannot be replayed from
# another site by a preflight that was allowed too broadly.

{
	# Where Let's Encrypt sends expiry warnings. Change before deploying.
	email ops@aiknol.com

	# Caddy answers HTTP/3 by default; nothing here needs to opt in.
}

gstbot.aiknol.com {
	log {
		output file /var/log/caddy/gstbot.log {
			roll_size 20MiB
			roll_keep 10
			roll_keep_for 720h
		}
		# The application logs JSON to journald under LOG_FORMAT=json; the
		# edge matching that means one shipper configuration covers both.
		format json
	}

	encode zstd gzip

	# Above the application's MAX_UPLOAD_MB=15 on purpose. The limit a user
	# should ever meet is the app's, which answers with a JSON error the UI
	# renders; this one exists so a multi-gigabyte body is dropped at the edge
	# rather than streamed into a Python process first.
	request_body {
		max_size 32MB
	}

	header {
		# Set here rather than left to the API so it also covers the SPA and
		# the redirect from http://. The API sends the same value when
		# HSTS_ENABLED=true; Caddy replaces rather than appends, so there is
		# exactly one header on the wire either way.
		Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
		# Nothing downstream should be making decisions on the server banner.
		-Server
	}

	# ---- API ----
	# Deliberately no security headers here: the application sets its own, and
	# they are stricter than anything appropriate for a page (its CSP is
	# `default-src 'none'`). Overwriting them at the edge would loosen them.
	handle /api/* {
		reverse_proxy 127.0.0.1:8000 {
			# X-Forwarded-For, -Proto and -Host are set by Caddy already.
			# X-Real-IP is not, and the API's rate limiter reads it.
			header_up X-Real-IP {remote_host}

			transport http {
				dial_timeout 10s
				# An upload whose parse falls back to inline processing is
				# waiting on a free-tier model call. The default 0 (no
				# timeout) would be worse: a hung upstream would pin the
				# connection forever.
				read_timeout 300s
				write_timeout 300s
			}

			# Exports stream; buffering them costs memory and time to first
			# byte. Caddy does not buffer by default — this is here so that
			# stays true if somebody adds a buffering directive later.
			flush_interval -1
		}
	}

	# ---- Hashed assets ----
	# Vite emits /assets/index-<hash>.js. The name changes whenever the
	# content does, so these can be cached forever and must be, or every
	# returning user re-downloads the whole bundle.
	handle /assets/* {
		root * /srv/gstbot/web
		header {
			Cache-Control "public, max-age=31536000, immutable"
			X-Content-Type-Options nosniff
		}
		file_server
	}

	# ---- SPA ----
	handle {
		root * /srv/gstbot/web
		header {
			# index.html is the only file whose name does not change between
			# releases. A cached copy pins the user to a bundle that no longer
			# exists on disk, which reads as a blank page.
			Cache-Control "no-store"
			X-Content-Type-Options nosniff
			X-Frame-Options DENY
			Referrer-Policy strict-origin-when-cross-origin
			Cross-Origin-Opener-Policy same-origin
			Permissions-Policy "geolocation=(), microphone=(), camera=(), payment=()"
			# connect-src 'self' is what makes the same-origin arrangement
			# above enforceable: a script that got onto the page still cannot
			# post a tenant's invoices anywhere else.
			#
			# style-src carries 'unsafe-inline' because several components set
			# a width or a height through the style attribute (the meters and
			# the dashboard bars, whose values are computed). script-src does
			# not, and must not: the build emits no inline script.
			Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; base-uri 'none'; form-action 'self'; frame-ancestors 'none'; object-src 'none'"
		}
		# /invoices/42 is a React route, not a file on disk.
		try_files {path} /index.html
		file_server
	}
}
